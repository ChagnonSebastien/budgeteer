export SERVER_PUBLICURL=http://localhost:8080

# Where the client IP comes from, used by the guest login rate limits. Pick the line matching your ingress:
#   One reverse proxy (nginx, Traefik, Caddy) in front of the app: X-Forwarded-For
#     (with two chained proxies the last entry is the outer proxy, so set X-Real-IP on the inner one instead)
#   Cloudflare, directly or through a reverse proxy:               CF-Connecting-IP
#     (only safe if the origin accepts traffic from Cloudflare alone, otherwise anyone can forge it)
#   nginx with the realip module or a proxy setting X-Real-IP:     X-Real-IP
#   No proxy, clients connect straight to the app:                 none
# A wrong header makes every user share one limit (header never set) or lets clients forge their IP (header set by the client).
export SERVER_CLIENTIPHEADER=X-Forwarded-For

export DATABASE_HOST=localhost
export DATABASE_PORT=5432
export DATABASE_USER=postgres
export DATABASE_PASSWORD=changeme
export DATABASE_NAME=budgetapp

export AUTH_USERPASS_ENABLED=false
export AUTH_OIDC_ENABLED=true
export AUTH_OIDC_CLIENTID=""
export AUTH_OIDC_CLIENTSECRET=""
export AUTH_OIDC_PROVIDERURL=""
